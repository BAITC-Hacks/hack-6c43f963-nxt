[
  {
    "start": 0.2512363996043522,
    "end": 2.4887407270029676,
    "text": "Раньше подготовка события начиналась с десятков",
    "scene": 1
  },
  {
    "start": 2.437589638971316,
    "end": 3.1035775222551933,
    "text": "вкладок.",
    "scene": 1
  },
  {
    "start": 3.1885231206726017,
    "end": 4.009020771513353,
    "text": "Кто свободен?",
    "scene": 1
  },
  {
    "start": 3.9402571711177057,
    "end": 4.709518422354106,
    "text": "Сколько стоит?",
    "scene": 1
  },
  {
    "start": 4.657566765578635,
    "end": 5.7166339020771515,
    "text": "Подойдёт ли формат?",
    "scene": 1
  },
  {
    "start": 5.784767556874383,
    "end": 7.563545994065282,
    "text": "Всё приходилось проверять вручную.",
    "scene": 1
  },
  {
    "start": 8.293826739427011,
    "end": 9.69731923601637,
    "text": "Теперь — seelect.",
    "scene": 2
  },
  {
    "start": 9.699079126875851,
    "end": 11.560961800818552,
    "text": "Умный подбор подрядчиков для вашего события",
    "scene": 2
  },
  {
    "start": 11.471759890859481,
    "end": 12.156869031377898,
    "text": "в Казахстане.",
    "scene": 2
  },
  {
    "start": 12.174386084583901,
    "end": 13.48620054570259,
    "text": "От условий — к понятному выбору.",
    "scene": 2
  },
  {
    "start": 14.298264933880528,
    "end": 16.130025079799363,
    "text": "Например, свадьба в Алматы.",
    "scene": 3
  },
  {
    "start": 16.28231646146831,
    "end": 19.106477428180575,
    "text": "Выбираем ведущего, дату и бюджет.",
    "scene": 3
  },
  {
    "start": 19.226513907888737,
    "end": 21.971162790697676,
    "text": "При необходимости добавляем язык и длительность.",
    "scene": 3
  },
  {
    "start": 22.075446876424987,
    "end": 23.602621617122303,
    "text": "Все условия — в одной форме.",
    "scene": 3
  },
  {
    "start": 24.297201172755976,
    "end": 26.44284393324312,
    "text": "Получаем до трёх подходящих вариантов.",
    "scene": 4
  },
  {
    "start": 26.449724853405503,
    "end": 28.817223725755525,
    "text": "Фото, цена и главное — почему",
    "scene": 4
  },
  {
    "start": 28.72912945421741,
    "end": 30.210687866486243,
    "text": "именно этот специалист.",
    "scene": 4
  },
  {
    "start": 30.280638249887232,
    "end": 32.80618177717636,
    "text": "Объяснение опирается на бюджет, формат и",
    "scene": 4
  },
  {
    "start": 32.71808750563825,
    "end": 33.617180875056384,
    "text": "данные профиля.",
    "scene": 4
  },
  {
    "start": 34.28221624503247,
    "end": 35.95491082679074,
    "text": "Меняем дату — меняется подбор.",
    "scene": 5
  },
  {
    "start": 35.942231268779686,
    "end": 38.23123388581952,
    "text": "Занятые специалисты не попадут в рекомендации.",
    "scene": 5
  },
  {
    "start": 38.24491373461278,
    "end": 40.159236212077154,
    "text": "Сначала проверяется календарь, и только потом",
    "scene": 5
  },
  {
    "start": 40.17291606087041,
    "end": 41.62281089463992,
    "text": "подключается искусственный интеллект.",
    "scene": 5
  },
  {
    "start": 42.26279793987304,
    "end": 43.34648221343873,
    "text": "Нет подходящих вариантов?",
    "scene": 6
  },
  {
    "start": 43.33916636722961,
    "end": 44.423437537429635,
    "text": "Сервис объяснит причину.",
    "scene": 6
  },
  {
    "start": 44.41612169122051,
    "end": 45.938217750628816,
    "text": "Например, цена выше бюджета.",
    "scene": 6
  },
  {
    "start": 46.068822613486645,
    "end": 47.89140974967062,
    "text": "А оценочные данные и синтетические профили",
    "scene": 6
  },
  {
    "start": 47.796646304946705,
    "end": 48.62434516442421,
    "text": "отмечены отдельно.",
    "scene": 6
  },
  {
    "start": 49.32416666666667,
    "end": 50.86666666666667,
    "text": "Не хотите заполнять форму?",
    "scene": 7
  },
  {
    "start": 50.96,
    "end": 53,
    "text": "Расскажите о событии своими словами в",
    "scene": 7
  },
  {
    "start": 52.91583333333334,
    "end": 53.53333333333333,
    "text": "чате.",
    "scene": 7
  },
  {
    "start": 53.62666666666667,
    "end": 56.306666666666665,
    "text": "Ассистент уточнит детали и запустит тот",
    "scene": 7
  },
  {
    "start": 56.222500000000004,
    "end": 56.87583333333333,
    "text": "же подбор.",
    "scene": 7
  },
  {
    "start": 56.862500000000004,
    "end": 59.25416666666667,
    "text": "Интерфейс — на русском и казахском.",
    "scene": 7
  },
  {
    "start": 60.242358752701456,
    "end": 63.66634146341463,
    "text": "Открываем профиль: описание, условия и объяснение",
    "scene": 8
  },
  {
    "start": 63.574801250385924,
    "end": 64.3017227539364,
    "text": "рекомендации.",
    "scene": 8
  },
  {
    "start": 64.28033922506947,
    "end": 65.77038013275703,
    "text": "Здесь же — форма заявки.",
    "scene": 8
  },
  {
    "start": 65.72053681691881,
    "end": 67.22447669033653,
    "text": "В текущем демо она показывает сценарий",
    "scene": 8
  },
  {
    "start": 67.13293647730781,
    "end": 68.62032996295153,
    "text": "записи без отправки подрядчику.",
    "scene": 8
  },
  {
    "start": 69.25931140543979,
    "end": 70.34880344389003,
    "text": "Шестьдесят шесть профилей.",
    "scene": 9
  },
  {
    "start": 70.3945427918012,
    "end": 71.22406240827708,
    "text": "Строгие фильтры.",
    "scene": 9
  },
  {
    "start": 71.19829548234028,
    "end": 72.25286585216712,
    "text": "Понятные рекомендации.",
    "scene": 9
  },
  {
    "start": 72.2625749070541,
    "end": 74.03830544956463,
    "text": "Основной подбор работает даже без искусственного",
    "scene": 9
  },
  {
    "start": 73.94214087418061,
    "end": 74.45237666324235,
    "text": "интеллекта.",
    "scene": 9
  },
  {
    "start": 74.46208571812934,
    "end": 76.19053342994816,
    "text": "Меньше поиска — больше внимания вашему",
    "scene": 9
  },
  {
    "start": 76.09398083602387,
    "end": 76.6319322351042,
    "text": "событию.",
    "scene": 9
  },
  {
    "start": 77.28916666666667,
    "end": 78.60000000000001,
    "text": "seelect.",
    "scene": 10
  },
  {
    "start": 78.71083333333334,
    "end": 79.59583333333335,
    "text": "Ваш повод.",
    "scene": 10
  },
  {
    "start": 79.67083333333333,
    "end": 80.8225,
    "text": "Ваша команда.",
    "scene": 10
  },
  {
    "start": 80.91583333333334,
    "end": 82.6922373393802,
    "text": "Работа команды nxt.",
    "scene": 10
  }
]